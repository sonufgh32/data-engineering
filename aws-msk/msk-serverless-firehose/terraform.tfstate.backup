            "user_data": "#!/bin/bash\r\nset -euo pipefail\r\n\r\nexec \u003e \u003e(tee /var/log/user-data.log | logger -t user-data -s 2\u003e/dev/console) 2\u003e\u00261\r\n\r\necho \"Starting producer host bootstrap\"\r\n\r\nif command -v dnf \u003e/dev/null 2\u003e\u00261; then\r\n  dnf install -y python3 python3-pip git\r\nelif command -v yum \u003e/dev/null 2\u003e\u00261; then\r\n  yum install -y python3 python3-pip git\r\nfi\r\n\r\nmkdir -p /opt/msk-producer\r\ncd /opt/msk-producer\r\n\r\naws s3 cp \"s3://shivchoudhury-datasets-kafka/bootstrap/producer/README.md\" \"README.md\"\r\naws s3 cp \"s3://shivchoudhury-datasets-kafka/bootstrap/producer/config.py\" \"config.py\"\r\naws s3 cp \"s3://shivchoudhury-datasets-kafka/bootstrap/producer/create_topic.py\" \"create_topic.py\"\r\naws s3 cp \"s3://shivchoudhury-datasets-kafka/bootstrap/producer/kafka_utils.py\" \"kafka_utils.py\"\r\naws s3 cp \"s3://shivchoudhury-datasets-kafka/bootstrap/producer/producer.py\" \"producer.py\"\r\naws s3 cp \"s3://shivchoudhury-datasets-kafka/bootstrap/producer/requirements.txt\" \"requirements.txt\"\r\naws s3 cp \"s3://shivchoudhury-datasets-kafka/bootstrap/producer/run_on_ec2.sh\" \"run_on_ec2.sh\"\r\n\r\nchmod +x run_on_ec2.sh\r\n\r\npython3 -m venv .venv\r\nsource .venv/bin/activate\r\npip install --upgrade pip\r\npip install -r requirements.txt\r\n\r\ncat \u003e /etc/profile.d/msk_producer_env.sh \u003c\u003cEOF_ENV\r\nexport AWS_REGION=\"ap-south-1\"\r\nexport BOOTSTRAP_SERVERS=\"boot-wqlqptw8.c2.kafka-serverless.ap-south-1.amazonaws.com:9098\"\r\nexport TOPIC=\"sample-topic\"\r\nexport INTERVAL=\"5\"\r\nEOF_ENV\r\n\r\ncat \u003e /usr/local/bin/msk-producer-run \u003c\u003c'EOF_RUNNER'\r\n#!/bin/bash\r\nset -euo pipefail\r\nsource /etc/profile.d/msk_producer_env.sh\r\ncd /opt/msk-producer\r\nsource .venv/bin/activate\r\npython producer.py run --topic \"${TOPIC}\" --interval \"${INTERVAL}\" --bootstrap \"${BOOTSTRAP_SERVERS}\"\r\nEOF_RUNNER\r\nchmod +x /usr/local/bin/msk-producer-run\r\n\r\necho \"Bootstrap complete. Use 'msk-producer-run' to start producer.\"\r\n",
            "user_data_base64": null,
