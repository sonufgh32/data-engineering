              }
            ],
            "private_ip": "10.0.10.187",
            "public_dns": "ec2-3-110-225-254.ap-south-1.compute.amazonaws.com",
            "public_ip": "3.110.225.254",
            "region": "ap-south-1",
            "root_block_device": [
              {
                "delete_on_termination": true,
                "device_name": "/dev/xvda",
                "encrypted": false,
                "iops": 3000,
                "kms_key_id": "",
                "tags": {
                  "Environment": "dev",
                  "ManagedBy": "Terraform",
